# ── Server ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/cmes
JWT_SECRET=replace_with_32char_random_string
JWT_EXPIRES_IN=24h
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
# Dev:        http://localhost:5173
# Production: https://cmes-client.onrender.com
CLIENT_URL=http://localhost:5173

# ── Email (optional in dev — Ethereal is used automatically) ──────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@cmes.edu
SMTP_PASS=replace_with_smtp_password

# ── Frontend (client/.env) ────────────────────────────────────────────────────
# Leave blank in dev (Vite proxy handles it)
# Set in production: VITE_API_URL=https://cmes-server.onrender.com/api
VITE_API_URL=
